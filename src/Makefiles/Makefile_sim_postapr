# ---------------------------------------------------------------------------
# Milestone 3: post-APR gate-level simulation (run from sim/apr)
#
# Simulates ../../apr/results/matrix_mult_wrapper_9.apr.v with SDF delays and timing
# checks. The bound checkers need RTL internals, so only self-checking testbenches run.
#
#   make                 same as make vcs
#   make vcs             build the C simulator, generate golden data, then run
#                        tb_matrix_mult_gate (golden + directed tests through the
#                        wrapper netlist). Ends with TB RESULT: PASSED/FAILED
#   make vcs TEST=rand_full_0         run one test from tests/tests.list
#   make golden NUM_RANDOM=50 SEED=7  only regenerate the test vectors
#   make wrapper TB=tb_matrix_mult_wrapper_bist   one wrapper-level test
#   make regress         run every test above and print a PASS/FAIL summary
#   make <target> CORNER=min          use the min SDF delays (hold) instead of max (setup)
#   make <target> SDF=0               no SDF and no timing checks (zero-delay netlist)
#   make <target> DUMP=1              dump matrix_mult.fsdb (large for a netlist)
#   make cov_report      coverage report in urgReport/dashboard.html
#   make verdi           open the last memory-mode waveform (needs DUMP=1)
#   make clean / wipe    remove simulation outputs / also remove linked sources and tests
# ---------------------------------------------------------------------------
DESIGN      = matrix_mult_wrapper_9
MEM_TB      = tb_matrix_mult_gate
TESTNAME    = default
SRC_VERILOG = ../../src/verilog
SRC_FOLDER  = $(SRC_VERILOG)
SIM_C_DIR   = ../../src/Simulator
GEN_GOLDEN  = ../../scripts/gen_golden.py
SIM=1
SDF=1
DUMP=0

# Netlist, SDF and standard cell models. SDF_FILE picks a file with the corner in its
# name if there is one, otherwise the first .sdf in the results folder
RESULTS_DIR = ../../apr/results
NETLIST     = $(RESULTS_DIR)/$(DESIGN).apr.v
CORNER      = max

SDF_CORNER_max = wc
SDF_CORNER_min = bc
SDF_FILE = $(RESULTS_DIR)/$(DESIGN).$(SDF_CORNER_$(CORNER)).sdf

STDCELL_DIR = /tools/pdk/tsmc/musesemi/65MSRFGP/tcbn65gplus_200a/TSMCHOME/digital/Front_End/verilog/tcbn65gplus_200a
STDCELL_V   = $(STDCELL_DIR)/tcbn65gplus_pwr.v

# Everything a testbench needs besides itself: cell models, netlist, packages, memory models
GATE_FILES  = $(STDCELL_V) $(NETLIST) matrix_mult_pkg.sv controller_fsm_pkg.sv \
              pseudo_rand_num_gen_pkg.sv mm_verif_pkg.sv mem_emulator.sv mem2p_emulator.sv

# Golden test generation and simulation options
TEST_DIR    = tests
NUM_RANDOM  = 10
SEED        = 4804
TEST        =
COV_METRICS = assert
SIM_ARGS    = +testdir=$(TEST_DIR) +testname=$(TESTNAME) $(if $(TEST),+test=$(TEST))

#Build up a list of verilog define statements to be used by vcs.
#PG_PINS connects VDD/VSS on tb_matrix_mult_gate (the wrapper TBs connect them through .*)
VERILOG_DEFINES:=+PG_PINS=1
ifeq ($(SIM), 1)
		VERILOG_DEFINES := $(VERILOG_DEFINES)+SIM=1
endif
ifeq ($(DUMP), 0)
		VERILOG_DEFINES := $(VERILOG_DEFINES)+NO_FSDB=1
endif

# SDF is annotated on <TB>.dut at compile time. Negative timing check limits are kept
ifeq ($(SDF), 1)
		SDF_FLAGS = -sdf $(CORNER):$(TB).dut:$(SDF_FILE) +sdfverbose +neg_tchk -negdelay
else
		SDF_FLAGS = +notimingcheck
endif

.DEFAULT_GOAL := vcs
.PHONY: vcs verify run check_inputs golden simulator link_src cov_report verdi help clean wipe

# Move all the verilog files from the source directory over to this simulation directory.
# The netlist and SDF are read from RESULTS_DIR directly
link_src:
	find $(SRC_FOLDER) -name '*.v' -exec ln -s -f {} ';'
	find $(SRC_FOLDER) -name '*.sv' -exec ln -s -f {} ';'
	find $(SRC_FOLDER) -name '*.svh' -exec ln -s -f {} ';'

check_inputs:
	@test -f $(NETLIST) || { echo "Missing netlist $(NETLIST). Run APR first."; exit 1; }
	@test -f $(STDCELL_V) || { echo "Missing cell models $(STDCELL_V). Set STDCELL_V=<path>."; exit 1; }
	@if [ "$(SDF)" = 1 ] && [ -z "$(SDF_FILE)" ]; then \
		echo "No .sdf in $(RESULTS_DIR). Set SDF_FILE=<path> or run with SDF=0."; exit 1; fi
	@if [ "$(SDF)" = 1 ]; then echo "SDF: $(SDF_FILE) ($(CORNER) delays)"; else echo "SDF: off"; fi

# Rebuild the C golden model on this machine. A sim.out built on another machine
# can need a newer glibc than this one has
simulator:
	$(MAKE) -s -C $(SIM_C_DIR) clean all

# The EDA setup puts other libpython builds on LD_LIBRARY_PATH, which breaks python3
golden: simulator
	env -u LD_LIBRARY_PATH python3 $(GEN_GOLDEN) --out $(TEST_DIR) --num-random $(NUM_RANDOM) --seed $(SEED)

# Compile one testbench against the netlist and run it.
# Each test gets its own simv_<TB>, <TB>.vdb and <TB>.log so runs don't overwrite each other.
run: link_src check_inputs
	rm -f $(TB).log
	vcs -top $(TB) $(GATE_FILES) $(TB).sv +v2k +lint=all -sverilog -full64 \
		-timescale=1ns/1ps -debug_acc+pp+dmptf -debug_region+cell+encrypt \
		-debug_access -l $(TB)_compile.log +define+$(VERILOG_DEFINES) $(SDF_FLAGS) \
		-cm $(COV_METRICS) -cm_dir $(TB).vdb -lca -kdb -o simv_$(TB)
	./simv_$(TB) -cm $(COV_METRICS) -cm_dir $(TB).vdb -l $(TB).log $(SIM_ARGS)

# Memory mode: golden tests + directed tests
vcs: golden
	$(MAKE) run TB=$(MEM_TB)
	@grep -E "TB RESULT" $(MEM_TB).log || true

# Old name for the full flow
verify: vcs

cov_report:
	urg -dir $(wildcard *.vdb) -format both -report urgReport

verdi:
	verdi -ssf matrix_mult.fsdb -dbdir simv_$(MEM_TB).daidir &

help:
	@sed -n '2,20p' $(firstword $(MAKEFILE_LIST))

clean:
	rm -rf DVEfiles
	rm -rf *.log
	rm -rf *.vpd
	rm -rf *.fsdb
	rm -rf ucli.key
	rm -rf alib-52
	rm -rf simv simv.daidir csrc
	rm -rf simv_* *.vdb
	rm -rf urgReport sdfAnnotateInfo
	rm -rf verdiLog novas* vc_hdrs.h

wipe: clean
	rm -rf *.include
	rm -rf *.sv *.v *.svh
	rm -rf default.svf
	rm -rf $(TEST_DIR)

# Wrapper-level tests on the netlist. Without the bound checkers, the external-mode tests
# check output row counts and phantom starts. Full BiST checks the signature against an
# independent golden value, so it covers the array arithmetic end to end.
WRAPPER_TBS = tb_matrix_mult_wrapper_external tb_matrix_mult_wrapper_registered \
              tb_matrix_mult_wrapper_bist tb_matrix_mult_wrapper_full_bist
TB          = tb_matrix_mult_wrapper_full_bist

.PHONY: wrapper regress
wrapper:
	$(MAKE) run TB=$(TB)

# Full regression: memory mode (golden tests + directed tests), then every wrapper test.
# A failing test does not stop the others. A test passes only if its log has its PASSED line,
# so a compile error or crash shows up as FAIL. With SDF=1 it must also have no timing
# violations and no SDF annotation errors.
regress:
	rm -f $(MEM_TB).log $(addsuffix .log,$(WRAPPER_TBS))
	-$(MAKE) vcs
	-for tb in $(WRAPPER_TBS); do $(MAKE) wrapper TB=$$tb || true; done
	@fail=0; \
	check() { \
	  if [ ! -f "$$1.log" ] || ! grep -q "$$2" "$$1.log"; then \
	    echo "FAIL  $$1  (see $$1.log and $$1_compile.log)"; fail=1; \
	  elif [ "$(SDF)" = 1 ] && grep -q "Error-\[SDF" "$$1_compile.log"; then \
	    echo "FAIL  $$1  (SDF annotation errors in $$1_compile.log)"; fail=1; \
	  elif [ "$(SDF)" = 1 ] && grep -q "Timing violation" "$$1.log"; then \
	    echo "FAIL  $$1  ($$(grep -c 'Timing violation' $$1.log) timing violations in $$1.log)"; fail=1; \
	  else echo "PASS  $$1"; fi; }; \
	echo ""; echo "============ POST-APR REGRESSION SUMMARY ($(if $(filter 1,$(SDF)),$(CORNER) SDF,no SDF)) ============"; \
	check $(MEM_TB)                        "TB RESULT: PASSED"; \
	check tb_matrix_mult_wrapper_external  "WRAPPER DIRECT EXTERNAL PASSED"; \
	check tb_matrix_mult_wrapper_registered "WRAPPER REGISTERED EXTERNAL PASSED"; \
	check tb_matrix_mult_wrapper_bist      "WRAPPER BIST LOOPBACK PASSED"; \
	check tb_matrix_mult_wrapper_full_bist "WRAPPER FULL BIST PASSED"; \
	echo "============================================================"; \
	if [ $$fail -eq 0 ]; then echo "REGRESSION: ALL PASSED"; else echo "REGRESSION: FAILED"; exit 1; fi
